{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dev-stack-site-assets",
  "main": "assets-worker.mjs",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "EXPRESS_ORIGIN": "https://express.example.com",
    "PYTHON_ORIGIN": "https://python.example.com",
    "WORKER_ORIGIN": "https://dev-stack-backend.example.workers.dev"
  }
}
