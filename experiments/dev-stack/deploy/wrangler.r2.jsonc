{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dev-stack-site-r2",
  "main": "r2-worker.mjs",
  "compatibility_date": "2026-10-13",
  "r2_buckets": [{ "binding": "SITE", "bucket_name": "dev-stack-site" }],
  "vars": {
    "STATIC_PREFIX": "site",
    "EXPRESS_ORIGIN": "https://express.example.com",
    "PYTHON_ORIGIN": "https://python.example.com",
    "WORKER_ORIGIN": "https://dev-stack-backend.example.workers.dev"
  }
}
