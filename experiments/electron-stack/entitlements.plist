<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron and the independent Node runtime use V8 JIT compilation.
         No App Sandbox, get-task-allow, or library-validation bypass. Review
         file-specific entitlements when adding native libraries/capabilities. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
