{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "scripts/*.ts", "test", "electron.vite.config.ts"]
}
