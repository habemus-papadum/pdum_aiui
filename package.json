{
  "name": "pdum_aiui",
  "version": "0.21.0+dev",
  "private": true,
  "type": "module",
  "description": "pdum_aiui - a UI framework for agent-written scientific interfaces, its AI utilities, and the demos: a lockstep-versioned TypeScript monorepo.",
  "author": "Nehal Patel <nehal@alum.mit.edu>",
  "license": "MIT",
  "engines": {
    "node": ">=24.5.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "demo": "pnpm -C demos/gallery dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "new-demo": "tsx scripts/new-demo.ts",
    "new-package": "node scripts/new-package.mjs",
    "npm:list": "node scripts/npm-provision.mjs list",
    "npm:reserve": "node scripts/npm-provision.mjs reserve",
    "prepare": "git config core.hooksPath .githooks",
    "publish:gallery": "pnpm -C demos/gallery run publish",
    "skills:check": "node scripts/check-skill-links.mjs",
    "test": "vitest run",
    "test:packaging": "node scripts/packaging-test.mjs",
    "test:template": "tsx scripts/template-e2e.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "version:check": "node scripts/versioning.mjs current"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "^26.1.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.9.0"
}
