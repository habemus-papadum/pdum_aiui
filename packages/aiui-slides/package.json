{
  "name": "@habemus-papadum/aiui-slides",
  "version": "0.17.2+dev",
  "description": "The slides framework: a deck of viewport-sized, scroll-snapped slides as an ordinary aiui app — current slide as a control, HUD grid overview with live previews, widget-first navigation over a modal-kit keymap, and the Lens (hover preview → interactive detail overlay, folded into the page's reactive graph). Design contract: docs/proposals/slides.md.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-slides"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles.css": "./src/styles.css"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@habemus-papadum/aiui-viz": "workspace:^",
    "@solidjs/web": "catalog:solid",
    "solid-js": "catalog:solid"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "vitest": "catalog:"
  }
}
