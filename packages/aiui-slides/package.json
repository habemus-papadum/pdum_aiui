{
  "name": "@habemus-papadum/aiui-slides",
  "version": "0.24.1",
  "description": "The slides framework: a deck of viewport-sized slides moved one frame at a time as an ordinary aiui app — current slide + scene step as controls, wheel/touch quantized to one step per gesture, additive in-slide scenes, HUD grid overview with live previews, widget-first navigation over a modal-kit keymap, and the Lens (hover preview → interactive detail overlay, folded into the page's reactive graph — now aiui-viz's, re-exported here). Design contract: docs/proposals/slides.md.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-slides"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles.css": "./src/styles.css"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@habemus-papadum/aiui-viz": "workspace:>=0.24.0",
    "solid-js": ">=2.0.0-rc.13 <3",
    "@solidjs/web": ">=2.0.0-rc.13 <3"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:*",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "vitest": "catalog:",
    "@habemus-papadum/aiui-viz": "workspace:*",
    "solid-js": "catalog:solid",
    "@solidjs/web": "catalog:solid"
  }
}
