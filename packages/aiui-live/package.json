{
  "name": "@habemus-papadum/aiui-live",
  "version": "0.19.0",
  "description": "The live oracle — a full-duplex voice front (OpenAI GPT-Live over WebRTC/WebSocket) with pluggable delegation backends: local tools, hosted Responses, or Claude Code.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-live"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./widgets": "./src/widgets/index.ts",
    "./node": "./src/node/index.ts",
    "./claude": "./src/claude/index.ts",
    "./vite": "./src/vite.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./widgets": {
        "types": "./dist/widgets/index.d.ts",
        "import": "./dist/widgets.js",
        "default": "./dist/widgets.js"
      },
      "./node": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node.js",
        "default": "./dist/node.js"
      },
      "./claude": {
        "types": "./dist/claude/index.d.ts",
        "import": "./dist/claude.js",
        "default": "./dist/claude.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "import": "./dist/vite.js",
        "default": "./dist/vite.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && tsc --emitDeclarationOnly -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@habemus-papadum/aiui-viz": "workspace:^",
    "@solidjs/web": "catalog:solid",
    "solid-js": "catalog:solid",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0",
    "vite": "^6.0.0",
    "zod": ">=3.23.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@types/node": "^22.0.0",
    "@types/ws": "catalog:",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "zod": "^4.0.0"
  }
}
