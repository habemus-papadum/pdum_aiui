{
  "name": "@habemus-papadum/aiui-live",
  "version": "0.23.0+dev",
  "private": true,
  "description": "The live oracle — a full-duplex voice front (OpenAI GPT-Live over WebRTC/WebSocket) with pluggable delegation backends: local tools, hosted Responses, or Claude Code.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/internal/aiui-live"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./widgets": "./src/widgets/index.ts",
    "./node": "./src/node/index.ts",
    "./claude": "./src/claude/index.ts",
    "./vite": "./src/vite.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && tsc --emitDeclarationOnly -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@habemus-papadum/aiui-prompts": "workspace:^",
    "@habemus-papadum/aiui-prompts-inspector": "workspace:^",
    "@habemus-papadum/aiui-viz": "workspace:^",
    "@solidjs/web": "catalog:solid",
    "solid-js": "catalog:solid",
    "ws": "catalog:",
    "@habemus-papadum/aiui-audio": "workspace:^"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "zod": ">=3.23.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@types/node": "^22.0.0",
    "@types/ws": "catalog:",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "zod": "^4.0.0"
  }
}
