{
  "name": "@habemus-papadum/aiui-dock",
  "version": "0.22.0",
  "private": true,
  "description": "The voice dock: an oracle and a live session embedded in any aiui page, wired to its own tools, with a key field and the tool log",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/internal/aiui-dock"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@habemus-papadum/aiui-live": "workspace:^",
    "@habemus-papadum/aiui-oracle": "workspace:^",
    "@habemus-papadum/aiui-viz": "workspace:^",
    "@solidjs/web": "catalog:solid",
    "highlight.js": "^11.12.0",
    "marked": "^16.4.2",
    "solid-js": "catalog:solid",
    "@habemus-papadum/aiui-audio": "workspace:^"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "jsdom": "catalog:",
    "vite-plugin-solid": "catalog:solid"
  }
}
