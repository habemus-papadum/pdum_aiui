{
  "name": "@habemus-papadum/aiui-oracle",
  "version": "0.22.0",
  "private": true,
  "description": "The oracle — a realtime voice control surface for aiui apps (WebRTC to OpenAI Realtime, the app's cells as tools).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/internal/aiui-oracle"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./widgets": "./src/widgets/index.ts",
    "./server": "./src/mint-backend.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p lab/tsconfig.json",
    "test": "vitest run",
    "lab": "vite --config lab/vite.config.ts"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@habemus-papadum/aiui-source-processor": "workspace:^",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid"
  },
  "dependencies": {
    "@habemus-papadum/aiui-prompts": "workspace:^",
    "@habemus-papadum/aiui-prompts-inspector": "workspace:^",
    "@habemus-papadum/aiui-viz": "workspace:^",
    "@pydantic/genai-prices": "^0.1.0",
    "@solidjs/web": "catalog:solid",
    "solid-js": "catalog:solid",
    "@habemus-papadum/aiui-audio": "workspace:^"
  }
}
