{
  "name": "@habemus-papadum/aiui-claude-channel",
  "version": "0.15.0+dev",
  "description": "MCP server providing a custom Claude channel, plus a CLI to launch it and print config.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-claude-channel"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "aiui-claude-channel": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js",
        "default": "./dist/internal.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "render-audit": "tsx render-audit.mts"
  },
  "dependencies": {
    "@habemus-papadum/aiui-console": "workspace:^",
    "@habemus-papadum/aiui-intent-client": "workspace:^",
    "@habemus-papadum/aiui-lowering-pipeline": "workspace:^",
    "@habemus-papadum/aiui-pencil": "workspace:^",
    "@habemus-papadum/aiui-registry": "catalog:",
    "@habemus-papadum/aiui-remote-bar": "workspace:^",
    "@habemus-papadum/aiui-util": "workspace:^",
    "@inquirer/prompts": "^7.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pydantic/genai-prices": "^0.1.0",
    "commander": "catalog:",
    "express": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@types/express": "catalog:",
    "@types/ws": "catalog:"
  }
}
