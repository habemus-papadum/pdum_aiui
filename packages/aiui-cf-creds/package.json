{
  "name": "@habemus-papadum/aiui-cf-creds",
  "version": "0.24.0+dev",
  "description": "Broker-backed ephemeral credentials for aiui apps: adapters from the cf_browser_credentials kit to aiui's credential seams (the OpenAI realtime key source, STT connect, Mosaic connector, MotherDuck).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-cf-creds"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./openai": "./src/openai.ts",
    "./stt": "./src/stt.ts",
    "./mosaic": "./src/mosaic.ts",
    "./motherduck": "./src/motherduck.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./openai": {
        "types": "./dist/openai.d.ts",
        "import": "./dist/openai.js",
        "default": "./dist/openai.js"
      },
      "./stt": {
        "types": "./dist/stt.d.ts",
        "import": "./dist/stt.js",
        "default": "./dist/stt.js"
      },
      "./mosaic": {
        "types": "./dist/mosaic.d.ts",
        "import": "./dist/mosaic.js",
        "default": "./dist/mosaic.js"
      },
      "./motherduck": {
        "types": "./dist/motherduck.d.ts",
        "import": "./dist/motherduck.js",
        "default": "./dist/motherduck.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@habemus-papadum/cf-browser-credentials": ">=0.8.0",
    "@habemus-papadum/cf-creds-aws": ">=0.8.0",
    "@habemus-papadum/cf-creds-elevenlabs": ">=0.8.0",
    "@habemus-papadum/cf-creds-mosaic": ">=0.8.0",
    "@habemus-papadum/cf-creds-motherduck": ">=0.8.0",
    "@habemus-papadum/cf-creds-openai": ">=0.8.0"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": ">=1.29",
    "@motherduck/wasm-client": ">=1.5.5-r.1",
    "@uwdata/mosaic-core": ">=0.28",
    "@habemus-papadum/aiui-viz": "workspace:>=0.24.0"
  },
  "peerDependenciesMeta": {
    "@uwdata/mosaic-core": {
      "optional": true
    },
    "@motherduck/wasm-client": {
      "optional": true
    },
    "@duckdb/duckdb-wasm": {
      "optional": true
    },
    "@habemus-papadum/aiui-viz": {
      "optional": true
    }
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "catalog:",
    "@habemus-papadum/aiui-build-config": "workspace:*",
    "@habemus-papadum/aiui-viz": "workspace:*",
    "@motherduck/wasm-client": "1.5.5-r.1",
    "@uwdata/mosaic-core": "^0.28.1",
    "apache-arrow": "^17.0.0",
    "openai": "^7.4.0"
  }
}
