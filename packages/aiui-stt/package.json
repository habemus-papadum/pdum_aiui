{
  "name": "@habemus-papadum/aiui-stt",
  "version": "0.16.0+dev",
  "description": "Realtime speech-to-text as a pencil-shaped component: ElevenLabs Scribe v2 (default) and OpenAI transcription realtime engines behind one session seam, with injected credentials and audio.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-stt"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./mic": "./src/mic/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./mic": {
        "types": "./dist/mic/index.d.ts",
        "import": "./dist/mic.js",
        "default": "./dist/mic.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@habemus-papadum/aiui-oracle": "workspace:^",
    "@solidjs/web": "catalog:solid",
    "solid-js": "catalog:solid"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid"
  }
}
