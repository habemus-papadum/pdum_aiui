{
  "name": "@habemus-papadum/aiui-stt",
  "version": "0.23.0+dev",
  "description": "Browser speech-to-text with ElevenLabs Scribe, injected audio and credentials, and cumulative transcripts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-stt"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "test": "vitest run",
    "test:browser": "playwright test --project=offline",
    "test:live": "playwright test --config=playwright.live.config.ts"
  },
  "dependencies": {
    "@solidjs/web": "catalog:solid",
    "solid-js": "catalog:solid",
    "@habemus-papadum/aiui-audio": "workspace:^"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@habemus-papadum/cf-creds-elevenlabs": "^0.8.0",
    "@playwright/test": "^1.64.0",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid"
  }
}
