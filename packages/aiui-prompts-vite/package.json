{
  "name": "@habemus-papadum/aiui-prompts-vite",
  "version": "0.21.0+dev",
  "description": "Vite routing and optional source provenance instrumentation for structured prompt JSX.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-prompts-vite"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "biome check src test package.json tsconfig.json tsconfig.test.json vite.config.ts"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@habemus-papadum/aiui-source-processor": "workspace:^",
    "@solidjs/web": "catalog:solid",
    "@types/node": "^26.1.0",
    "solid-js": "catalog:solid",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@habemus-papadum/aiui-prompts": "workspace:^",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "vite": ">=8"
  }
}
