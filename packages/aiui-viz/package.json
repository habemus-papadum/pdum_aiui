{
  "name": "@habemus-papadum/aiui-viz",
  "version": "0.17.3",
  "description": "Reactive scientific-visualization utilities for agent-written frontends: Observable-style async cells for SolidJS 2.0, worker streaming, durable HMR registries, and the agent tool surface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-viz"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./plot": "./src/plot.tsx",
    "./mosaic": "./src/mosaic.tsx",
    "./embedding": "./src/embedding-view.tsx",
    "./mosaic-selection": "./src/mosaic-selection.ts",
    "./selection-views": "./src/selection-views.tsx",
    "./selection-inspector": "./src/selection-inspector.tsx",
    "./duckdb": "./src/duckdb.ts",
    "./site": "./src/site/index.ts",
    "./site/color-mode": "./src/site/color-mode.ts",
    "./modal": "./src/modal/index.ts",
    "./testing": "./src/testing.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./plot": {
        "types": "./dist/plot.d.ts",
        "import": "./dist/plot.js",
        "default": "./dist/plot.js"
      },
      "./mosaic": {
        "types": "./dist/mosaic.d.ts",
        "import": "./dist/mosaic.js",
        "default": "./dist/mosaic.js"
      },
      "./embedding": {
        "types": "./dist/embedding-view.d.ts",
        "import": "./dist/embedding.js",
        "default": "./dist/embedding.js"
      },
      "./mosaic-selection": {
        "types": "./dist/mosaic-selection.d.ts",
        "import": "./dist/mosaic-selection.js",
        "default": "./dist/mosaic-selection.js"
      },
      "./selection-views": {
        "types": "./dist/selection-views.d.ts",
        "import": "./dist/selection-views.js",
        "default": "./dist/selection-views.js"
      },
      "./selection-inspector": {
        "types": "./dist/selection-inspector.d.ts",
        "import": "./dist/selection-inspector.js",
        "default": "./dist/selection-inspector.js"
      },
      "./duckdb": {
        "types": "./dist/duckdb.d.ts",
        "import": "./dist/duckdb.js",
        "default": "./dist/duckdb.js"
      },
      "./site": {
        "types": "./dist/site/index.d.ts",
        "import": "./dist/site.js",
        "default": "./dist/site.js"
      },
      "./site/color-mode": {
        "types": "./dist/site/color-mode.d.ts",
        "import": "./dist/color-mode.js",
        "default": "./dist/color-mode.js"
      },
      "./modal": {
        "types": "./dist/modal/index.d.ts",
        "import": "./dist/modal.js",
        "default": "./dist/modal.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js",
        "default": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": ">=1.29",
    "@observablehq/plot": "^0.6",
    "@solidjs/web": ">=2.0.0-beta.32 <2.0.0-experimental.0",
    "@uwdata/mosaic-core": ">=0.28",
    "@uwdata/mosaic-plot": ">=0.28",
    "@uwdata/mosaic-sql": ">=0.28",
    "embedding-atlas": ">=0.24",
    "solid-js": ">=2.0.0-beta.32 <2.0.0-experimental.0",
    "katex": "^0.16 || ^0.17"
  },
  "peerDependenciesMeta": {
    "@duckdb/duckdb-wasm": {
      "optional": true
    },
    "embedding-atlas": {
      "optional": true
    },
    "@observablehq/plot": {
      "optional": true
    },
    "@uwdata/mosaic-core": {
      "optional": true
    },
    "@uwdata/mosaic-plot": {
      "optional": true
    },
    "@uwdata/mosaic-sql": {
      "optional": true
    },
    "katex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "catalog:",
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@observablehq/plot": "catalog:",
    "@solidjs/web": "catalog:solid",
    "@uwdata/mosaic-core": "^0.28.1",
    "@uwdata/mosaic-plot": "^0.28.1",
    "@uwdata/mosaic-spec": "^0.28.1",
    "@uwdata/mosaic-sql": "^0.28.1",
    "@uwdata/vgplot": "0.28.1",
    "embedding-atlas": "catalog:",
    "katex": "^0.17.0",
    "solid-js": "catalog:solid",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid"
  }
}
