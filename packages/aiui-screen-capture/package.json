{
  "name": "@habemus-papadum/aiui-screen-capture",
  "version": "0.22.0",
  "description": "Browser screen capture, native element cropping, and Solid preview controls.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-screen-capture"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./widgets": "./src/widgets.tsx"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./widgets": {
        "types": "./dist/widgets.d.ts",
        "import": "./dist/widgets.js",
        "default": "./dist/widgets.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.1.0",
    "jsdom": "catalog:",
    "vite-plugin-solid": "catalog:solid"
  },
  "dependencies": {
    "@habemus-papadum/aiui-viz": "workspace:^",
    "@solidjs/web": "catalog:solid",
    "solid-js": "catalog:solid"
  }
}
