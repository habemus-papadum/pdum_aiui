{
  "name": "@habemus-papadum/aiui-util",
  "version": "0.21.0+dev",
  "description": "The sidecar contract (what a host hands a mounted sidecar, and gets back) and the client-surface serving helper the aiui sidecar packages are built on.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-util"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./web-surface": "./src/web-surface.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./web-surface": {
        "types": "./dist/web-surface.d.ts",
        "import": "./dist/web-surface.js",
        "default": "./dist/web-surface.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@types/express": "catalog:",
    "express": "catalog:",
    "vite": "catalog:"
  }
}
