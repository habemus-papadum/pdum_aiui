{
  "name": "@habemus-papadum/aiui-prompts",
  "version": "0.21.0+dev",
  "description": "Structured prompt records, deterministic compilation, provenance, and delivery operations for Node.js and browsers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-prompts"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./operations": "./src/operations.ts",
    "./analysis": "./src/analysis.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./jsx-runtime": {
        "types": "./dist/jsx-runtime.d.ts",
        "import": "./dist/jsx-runtime.js",
        "default": "./dist/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/jsx-dev-runtime.d.ts",
        "import": "./dist/jsx-dev-runtime.js",
        "default": "./dist/jsx-dev-runtime.js"
      },
      "./operations": {
        "types": "./dist/operations.d.ts",
        "import": "./dist/operations.js",
        "default": "./dist/operations.js"
      },
      "./analysis": {
        "types": "./dist/analysis.d.ts",
        "import": "./dist/analysis.js",
        "default": "./dist/analysis.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "spike:authoring": "pnpm --filter @habemus-papadum/aiui-prompts-authoring-spike examples",
    "spike:playground": "pnpm --filter @habemus-papadum/aiui-prompts-authoring-spike dev",
    "spike:inspector": "pnpm --filter @habemus-papadum/aiui-prompts-inspector-spike dev",
    "lint": "biome check src test package.json tsconfig.json tsconfig.test.json vite.config.ts"
  },
  "devDependencies": {
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@types/node": "^26.1.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
