{
  "name": "@habemus-papadum/aiui-pencil",
  "version": "0.23.0",
  "description": "Editable stroke input, pure geometry, Canvas views, fading, and reactive observation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-pencil"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./input": "./src/input/index.ts",
    "./canvas": "./src/canvas.ts",
    "./solid": "./src/solid.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "import": "./dist/core.js",
        "default": "./dist/core.js"
      },
      "./input": {
        "types": "./dist/input/index.d.ts",
        "import": "./dist/input.js",
        "default": "./dist/input.js"
      },
      "./canvas": {
        "types": "./dist/canvas.d.ts",
        "import": "./dist/canvas.js",
        "default": "./dist/canvas.js"
      },
      "./solid": {
        "types": "./dist/solid.d.ts",
        "import": "./dist/solid.js",
        "default": "./dist/solid.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p lab/tsconfig.json",
    "test": "vitest run",
    "lab": "vite --config lab/vite.config.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@habemus-papadum/aiui-source-processor": "workspace:^",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "@playwright/test": "^1.64.0",
    "@solidjs/web": "catalog:solid"
  },
  "dependencies": {
    "@habemus-papadum/aiui-viz": "workspace:^",
    "solid-js": "catalog:solid"
  }
}
