{
  "name": "@habemus-papadum/aiui-pencil",
  "version": "0.21.0+dev",
  "description": "A pencil: pressure/tilt/azimuth-driven textured strokes, erasing, and vanishing ink, on a three-tier raster surface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "packages/aiui-pencil"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p lab/tsconfig.json",
    "test": "vitest run",
    "lab": "vite --config lab/vite.config.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@habemus-papadum/aiui-build-config": "workspace:^",
    "@habemus-papadum/aiui-source-processor": "workspace:^",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "@playwright/test": "^1.64.0",
    "@solidjs/web": "catalog:solid"
  },
  "dependencies": {
    "@habemus-papadum/aiui-viz": "workspace:^",
    "solid-js": "catalog:solid"
  }
}
