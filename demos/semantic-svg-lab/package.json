{
  "name": "@habemus-papadum/demo-semantic-svg-lab",
  "version": "0.23.0",
  "description": "Semantic SVG experiment: coordinated circuit views, terminal lens, and revisioned editing.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "demos/semantic-svg-lab"
  },
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page.tsx",
    "./card": "./src/card.tsx"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "aiui": {
    "sitePage": {
      "title": "semantic SVG",
      "desc": "one circuit, several interactive views",
      "order": 55,
      "card": "./card"
    }
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@habemus-papadum/aiui-design": "workspace:^",
    "@habemus-papadum/aiui-pencil": "workspace:^",
    "@habemus-papadum/aiui-source-processor": "workspace:^",
    "@habemus-papadum/aiui-viz": "workspace:^",
    "@solidjs/web": "catalog:solid",
    "solid-js": "catalog:solid",
    "katex": "^0.17.0"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@playwright/test": "^1.64.0",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "vitest": "catalog:"
  }
}
