{
  "name": "@habemus-papadum/demo-gears",
  "version": "0.0.0",
  "description": "A live involute-gear studio: two spur gears in kinematic mesh, the line of action and contact point, and a single-tooth studio — all pure geometry.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "demos/gears"
  },
  "exports": {
    ".": "./src/index.ts",
    "./gear": "./src/model/gear.ts",
    "./page": "./src/page.tsx",
    "./card": "./src/card.tsx"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "aiui": {
    "sitePage": {
      "title": "gears",
      "desc": "involute gears in kinematic mesh",
      "order": 50,
      "card": "./card"
    }
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@habemus-papadum/aiui-design": "workspace:>=0.24.0",
    "@habemus-papadum/aiui-dock": "workspace:>=0.0.0",
    "@habemus-papadum/aiui-source-processor": "workspace:>=0.24.0",
    "@habemus-papadum/aiui-viz": "workspace:>=0.24.0",
    "@solidjs/web": "catalog:solid",
    "solid-js": "catalog:solid"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "vitest": "catalog:"
  }
}
