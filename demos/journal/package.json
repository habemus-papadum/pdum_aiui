{
  "name": "@habemus-papadum/aiui-journal",
  "version": "0.17.2",
  "description": "The journal visual identity shared by the notebook demos and the gallery shell — system-following light/dark: design tokens + notebook chrome CSS, and the per-mode chart/Plot palette module. Internal, never published.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "demos/journal"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "private": true,
  "dependencies": {
    "@habemus-papadum/aiui-viz": "workspace:^",
    "solid-js": "catalog:solid"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
