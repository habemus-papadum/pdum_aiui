{
  "name": "@habemus-papadum/demo-catalog",
  "version": "0.22.1",
  "description": "In-repo aiui demo: the aiui-viz catalog, rendered — every piece the package provides, with a live specimen where one fits.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "demos/catalog"
  },
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page.tsx",
    "./card": "./src/card.tsx"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "aiui": {
    "sitePage": {
      "title": "catalog",
      "desc": "what aiui-viz provides — every piece, live",
      "order": 999,
      "card": "./card"
    }
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@habemus-papadum/aiui-design": "workspace:^",
    "@habemus-papadum/aiui-dock": "workspace:^",
    "@habemus-papadum/aiui-pencil": "workspace:^",
    "@habemus-papadum/aiui-source-processor": "workspace:^",
    "@habemus-papadum/aiui-viz": "workspace:^",
    "@observablehq/plot": "catalog:",
    "@solidjs/web": "catalog:solid",
    "katex": "^0.17.0",
    "marked": "^16.4.2",
    "mermaid": "^12.2.0",
    "solid-js": "catalog:solid"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "vitest": "catalog:"
  }
}
