{
  "name": "@habemus-papadum/demo-wine",
  "version": "0.21.0+dev",
  "description": "Wine reviews × Embedding Atlas: 120k tasting notes as a Mosaic-coordinated embedding map (embedding-atlas's EmbeddingViewMosaic) cross-filtered against points, price, variety, and country.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "demos/wine"
  },
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page.tsx",
    "./card": "./src/card.tsx",
    "./store": "./src/model/store.ts",
    "./specs": "./src/ui/specs.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "aiui": {
    "sitePage": {
      "title": "wine",
      "desc": "wine reviews on an embedding atlas",
      "order": 35,
      "card": "./card"
    }
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "catalog:",
    "@habemus-papadum/aiui-design": "workspace:^",
    "@habemus-papadum/aiui-dock": "workspace:^",
    "@habemus-papadum/aiui-source-processor": "workspace:^",
    "@habemus-papadum/aiui-viz": "workspace:^",
    "@solidjs/web": "catalog:solid",
    "@uwdata/mosaic-core": "^0.28.1",
    "@uwdata/mosaic-inputs": "^0.28.1",
    "@uwdata/mosaic-plot": "^0.28.1",
    "@uwdata/mosaic-spec": "^0.28.1",
    "@uwdata/mosaic-sql": "^0.28.1",
    "@uwdata/vgplot": "0.28.1",
    "embedding-atlas": "catalog:",
    "solid-js": "catalog:solid"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:solid",
    "vitest": "catalog:"
  }
}
