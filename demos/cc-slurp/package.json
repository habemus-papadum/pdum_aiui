{
  "name": "@habemus-papadum/aiui-cc-slurp",
  "version": "0.12.0+dev",
  "description": "Reader, normalizer and Parquet writer for Claude Code session transcripts: lenient accessors, billing dedup, fork lineage, cost derivation. Internal, never published.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "demos/cc-slurp"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "cc-slurp": "./bin/cc-slurp.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "normalize": "tsx src/cli.ts"
  },
  "private": true,
  "dependencies": {
    "hyparquet": "^1.20.0",
    "hyparquet-writer": "^0.16.1"
  },
  "devDependencies": {
    "tsx": "^4.22.5",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
