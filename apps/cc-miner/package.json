{
  "name": "@habemus-papadum/cc-miner",
  "version": "0.12.0+dev",
  "description": "Understand your own Claude Code usage, and whether it was time well spent.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_aiui.git",
    "directory": "apps/cc-miner"
  },
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page.tsx"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "claude": "../../bin/aiui claude",
    "dev": "vite",
    "dev:electron": "node electron/dev.mjs",
    "normalize": "pnpm -C ../cc-assay normalize -- --out ../cc-miner/src/data",
    "open": "../../bin/aiui open",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev61.0",
    "@habemus-papadum/aiui-source-processor": "workspace:^",
    "@habemus-papadum/aiui-viz": "workspace:^",
    "@habemus-papadum/cc-assay": "workspace:^",
    "@observablehq/plot": "^0.6.17",
    "@solidjs/web": "2.0.0-beta.15",
    "@uwdata/mosaic-core": "^0.28.1",
    "@uwdata/mosaic-sql": "^0.28.1",
    "@uwdata/vgplot": "0.28.1",
    "solid-js": "2.0.0-beta.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@habemus-papadum/aiui": "workspace:^",
    "electron": "^43.2.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.6.0",
    "typescript-language-server": "^5.3.0",
    "vite": "^6.4.1",
    "vite-plugin-solid": "3.0.0-next.5",
    "vitest": "^3.2.0"
  }
}
